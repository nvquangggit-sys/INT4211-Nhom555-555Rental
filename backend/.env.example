# =====================================================================
# MẪU biến môi trường - KHÔNG chứa giá trị thật, KHÔNG commit tệp .env
# Sao chép tệp này thành .env rồi điền giá trị của bạn.
# =====================================================================

# Cổng chạy local (Render tự cấp PORT, không cần đặt trên Render)
PORT=3000

# Chuỗi kết nối PostgreSQL trên Supabase.
# LẤY ĐÚNG CHUỖI: Supabase -> Connect -> Connection pooling -> Session mode (cổng 5432)
# TUYỆT ĐỐI không dùng Direct connection (IPv6) vì Render chỉ hỗ trợ IPv4.
DATABASE_URL=postgresql://postgres.PROJECT_REF:MAT_KHAU@aws-0-REGION.pooler.supabase.com:5432/postgres

# PostgreSQL nội bộ không có SSL thì đặt false. Supabase/Render để true.
PGSSL=true

# Chuỗi bí mật ký JWT, tối thiểu 32 ký tự ngẫu nhiên
JWT_SECRET=thay_bang_chuoi_ngau_nhien_toi_thieu_32_ky_tu
JWT_HAN=7d

# Supabase Storage để lưu ảnh biên lai / ảnh sự cố (không lưu base64 vào CSDL)
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=service_role_key_chi_dat_tren_server
SUPABASE_BUCKET=anh

# Chỉ dùng khi chạy local với lưu ảnh trên đĩa; production để trống
PUBLIC_BASE_URL=http://localhost:3000
